{% style %}
  @font-face {
    font-family: 'Fem Anniversary Display';
    src: url('{{ 'fem-anniversary-display-italic.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }
{% endstyle %}

<section class="fem-anniversary" aria-labelledby="fem-anniversary-title-{{ section.id }}" style="--anniversary-background: {{ section.settings.background_color }}; --anniversary-ink: {{ section.settings.text_color }}; --anniversary-accent: {{ section.settings.accent_color }};">
  <div class="fem-anniversary__media">
  <picture class="fem-anniversary__picture">
    {% if section.settings.mobile_image != blank %}
      <source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 1000 }}">
    {% endif %}
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'fem-anniversary__image', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: '' }}
    {% else %}
      <img class="fem-anniversary__image" src="{{ 'fem-anniversary-1280.webp' | asset_url }}" srcset="{{ 'fem-anniversary-840.webp' | asset_url }} 840w, {{ 'fem-anniversary-1280.webp' | asset_url }} 1280w, {{ 'fem-anniversary-1680.webp' | asset_url }} 1680w" sizes="(max-width: 749px) 170vw, 100vw" width="1683" height="935" alt="" loading="eager" fetchpriority="high" decoding="async">
    {% endif %}
  </picture>
  {% if section.settings.show_video %}
    {% assign video_id = 'fem-anniversary-video-' | append: section.id %}
    {% if section.settings.video != blank %}
      {{ section.settings.video | video_tag: id: video_id, class: 'fem-anniversary__video', autoplay: false, loop: true, muted: true, controls: false, preload: 'none', tabindex: '-1', aria-hidden: 'true' }}
    {% else %}
      <video id="{{ video_id }}" class="fem-anniversary__video" src="{{ 'fem-anniversary-video.mp4' | asset_url }}" muted loop playsinline preload="none" tabindex="-1" aria-hidden="true"></video>
    {% endif %}
  {% endif %}
  </div>
  <div class="fem-anniversary__ornaments" aria-hidden="true">
    <span class="fem-anniversary__star fem-anniversary__star--one">✦</span>
    <span class="fem-anniversary__star fem-anniversary__star--two">✧</span>
    <span class="fem-anniversary__star fem-anniversary__star--three">✦</span>
    <span class="fem-anniversary__star fem-anniversary__star--four">✧</span>
  </div>
  <div class="fem-anniversary__content">
    {% if section.settings.brand != blank %}
      <p class="fem-anniversary__brand">{{ section.settings.brand | escape }}<span aria-hidden="true">♥</span></p>
    {% endif %}
    <h1 id="fem-anniversary-title-{{ section.id }}" class="fem-anniversary__title">
      <span class="fem-anniversary__number">{{ section.settings.number | escape }}</span>
      <span class="fem-anniversary__heading">{{ section.settings.heading | escape }}</span>
    </h1>
    {% if section.settings.description != blank %}
      <p class="fem-anniversary__description">{{ section.settings.description | escape | newline_to_br }}</p>
    {% endif %}
    {% if section.settings.offer != blank %}
      <p class="fem-anniversary__offer"><span aria-hidden="true">✦</span><span>{{ section.settings.offer | escape }}</span><span aria-hidden="true">✦</span></p>
    {% endif %}
    {% if section.settings.link != blank and section.settings.button_label != blank %}
      <a class="fem-anniversary__button" href="{{ section.settings.link | escape }}">
        <span>{{ section.settings.button_label | escape }}</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 3h3l3 13h11l2-9H6M9 12h11"/><circle cx="9" cy="20" r="1.3"/><circle cx="18" cy="20" r="1.3"/></svg>
      </a>
    {% endif %}
  </div>
  {% if section.settings.show_video %}
    <button class="fem-anniversary__playback" type="button" aria-controls="{{ video_id }}" data-play-label="{{ 'fem_anniversary.play' | t | escape }}" data-pause-label="{{ 'fem_anniversary.pause' | t | escape }}" hidden>{{ 'fem_anniversary.play' | t }}</button>
  {% endif %}
</section>

{% stylesheet %}
  .fem-anniversary {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    width: 100%;
    min-height: 56vw;
    overflow: hidden;
    background: var(--anniversary-background, #db8996);
    color: var(--anniversary-ink, #ffffff);
    font-family: Georgia, 'Fem Anniversary Display', serif;
  }
  .fem-anniversary, .fem-anniversary * { box-sizing: border-box; }
  .fem-anniversary__media { position: absolute; inset: 0; z-index: -2; }
  .fem-anniversary__picture { display: block; width: 100%; height: 100%; }
  .fem-anniversary__image { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
  .fem-anniversary__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; opacity: 0; pointer-events: none; }
  .fem-anniversary__video[data-ready] { opacity: 1; }
  .fem-anniversary__playback { position: absolute; right: 18px; bottom: 18px; z-index: 1; min-height: 44px; padding: 10px 16px; border: 1px solid #fff3e2; border-radius: 24px; background: #84273ee6; color: #fff3e2; font: 500 13px/1.2 Arial, sans-serif; cursor: pointer; }
  .fem-anniversary__playback[hidden] { display: none; }
  .fem-anniversary__playback:focus-visible { outline: 3px solid #fff3e2; outline-offset: 3px; }
  .fem-anniversary__content { width: 57%; padding: 8.5vw 2.5vw 6vw; text-align: center; position: relative; container-type: inline-size; }
  .fem-anniversary .fem-anniversary__brand { margin: 0 0 2.8cqw; color: inherit; font: italic 700 8.7cqw/1 Georgia, 'Fem Anniversary Display', serif; letter-spacing: -.05em; }
  .fem-anniversary__brand > span { display: inline-block; margin-left: .3em; font: normal 400 .4em/1 Arial, sans-serif; vertical-align: .2em; }
  .fem-anniversary .fem-anniversary__title { display: flex; flex-direction: column; margin: 0 0 2.5cqw; color: inherit; font-weight: 700; text-transform: none; }
  .fem-anniversary__number { display: block; font: italic 700 20.5cqw/.87 Georgia, 'Fem Anniversary Display', serif; letter-spacing: -.045em; overflow-wrap: anywhere; }
  .fem-anniversary__heading { display: block; margin-top: -1cqw; font: italic 700 14.5cqw/.92 Georgia, 'Fem Anniversary Display', serif; letter-spacing: -.035em; overflow-wrap: anywhere; }
  .fem-anniversary .fem-anniversary__description { margin: 0 auto; color: inherit; font: 700 clamp(12px, 2.55cqw, 20px)/1.5 'Poppins', Arial, sans-serif; letter-spacing: -.035em; overflow-wrap: anywhere; }
  .fem-anniversary .fem-anniversary__offer { display: flex; align-items: center; justify-content: center; gap: 1.8cqw; margin: .5cqw auto 4.8cqw; color: inherit; font: italic 700 clamp(16px, 3.8cqw, 30px)/1.3 Georgia, 'Fem Anniversary Display', serif; letter-spacing: -.025em; }
  .fem-anniversary__offer > span[aria-hidden] { flex-shrink: 0; font-size: .7em; }
  .fem-anniversary__offer > span:not([aria-hidden]) { overflow-wrap: anywhere; }
  .fem-anniversary .fem-anniversary__button { display: inline-flex; align-items: center; justify-content: center; gap: 12px; min-height: 48px; max-width: 100%; padding: 15px 36px; border-radius: 999px; background: var(--anniversary-ink, #ffffff); color: var(--anniversary-accent, #ed6b82); box-shadow: 0 12px 22px #a734492b; font: 700 clamp(12px, 2.6cqw, 18px)/1.3 'Poppins', Arial, sans-serif; letter-spacing: .075em; text-transform: uppercase; text-decoration: none; transition: box-shadow 180ms ease, transform 180ms ease; }
  .fem-anniversary__button svg { flex-shrink: 0; }
  .fem-anniversary__button:hover { transform: translateY(-2px); box-shadow: 0 15px 26px #a734493d; }
  .fem-anniversary__button:focus-visible { outline: 3px solid #84273e; outline-offset: 5px; }
  .fem-anniversary__ornaments { position: absolute; inset: 0; pointer-events: none; z-index: -1; }
  .fem-anniversary__star { position: absolute; line-height: 1; font-size: 2.8vw; transform: rotate(14deg); }
  .fem-anniversary__star::after { content: '✦'; position: absolute; top: -.05em; right: -.38em; font-size: .35em; }
  .fem-anniversary__star--one { top: 23%; left: 51%; }
  .fem-anniversary__star--two { top: 43%; left: 5%; font-size: 1.6vw; }
  .fem-anniversary__star--three { bottom: 25%; left: 6%; font-size: 1.8vw; }
  .fem-anniversary__star--four { bottom: 29%; left: 52%; font-size: 2.3vw; }
  @media (min-width: 1800px) {
    .fem-anniversary { min-height: 1000px; }
    .fem-anniversary__content { padding-top: 150px; padding-bottom: 105px; }
  }
  @media (max-width: 749px) {
    .fem-anniversary { min-height: 0; display: block; padding-bottom: 77vw; }
    .fem-anniversary__media { top: auto; height: 93vw; }
    .fem-anniversary__image, .fem-anniversary__video { object-position: right bottom; }
    .fem-anniversary::after { content: ''; position: absolute; inset: auto 0 65vw; height: 29vw; background: linear-gradient(var(--anniversary-background), transparent); z-index: -1; pointer-events: none; }
    .fem-anniversary__content { width: 100%; padding: 116px 24px 30px; }
    .fem-anniversary .fem-anniversary__brand { margin-bottom: 4cqw; }
    .fem-anniversary .fem-anniversary__offer { margin-bottom: 7cqw; }
    .fem-anniversary__star { font-size: 6vw; }
    .fem-anniversary__star--one { top: 17%; left: 88%; }
    .fem-anniversary__star--two { top: 29%; left: 5%; font-size: 3vw; }
    .fem-anniversary__star--three { top: 51%; left: 8%; font-size: 4vw; }
    .fem-anniversary__star--four { top: 48%; left: 91%; font-size: 4vw; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Aniversario Fem",
  "tag": "div",
  "class": "fem-anniversary-section",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "brand", "label": "Marca", "default": "Fem" },
    { "type": "text", "id": "number", "label": "Número o frase principal", "default": "2do" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Aniversario" },
    { "type": "text", "id": "offer", "label": "Texto de la promoción", "default": "Hasta 20% OFF en toda la marca" },
    { "type": "textarea", "id": "description", "label": "Descripción", "default": "Celebra con nosotros 2 años de bienestar femenino" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Comprar ahora" },
    { "type": "url", "id": "link", "label": "Enlace de la promoción", "default": "/collections/all" },
    { "type": "checkbox", "id": "show_video", "label": "Mostrar video de fondo", "default": true },
    { "type": "video", "id": "video", "label": "Video de fondo", "info": "Opcional. Si no eliges otro, se usa el video de aniversario incluido. Se reproduce sin sonido y en bucle." },
    { "type": "image_picker", "id": "image", "label": "Imagen de fondo", "info": "Opcional. Se utiliza la torta de aniversario si no seleccionas otra imagen. Usa una imagen sin textos." },
    { "type": "image_picker", "id": "mobile_image", "label": "Imagen para móvil", "info": "Opcional. Se muestra debajo del texto." },
    { "type": "color", "id": "background_color", "label": "Fondo", "default": "#db8996" },
    { "type": "color", "id": "text_color", "label": "Texto y decoraciones", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Texto del botón", "default": "#ed6b82" }
  ],
  "presets": [{ "name": "Aniversario Fem" }]
}
{% endschema %}
