{{ 'fem-cart.css' | asset_url | stylesheet_tag }}
<dialog id="fem-cart-drawer" class="fem-cart" aria-labelledby="fem-cart-title">
  <div class="fem-cart__panel">
    <header class="fem-cart__header">
      <svg class="fem-cart__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 3h3l3 13h11l3-9H6M9 20h.01M18 20h.01" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9" cy="20" r="1.2"/><circle cx="18" cy="20" r="1.2"/></svg>
      <h2 id="fem-cart-title">{{ 'fem_cart.title' | t }} <span data-cart-count-label hidden>· <span data-fem-cart-count>0</span></span></h2>
      <button class="fem-cart__close" type="button" data-cart-close aria-label="{{ 'fem_cart.close' | t }}" autofocus><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="m4 4 12 12M16 4 4 16"/></svg></button>
    </header>
    <p class="fem-cart__status" data-cart-status role="status" aria-live="polite">{{ 'fem_cart.loading' | t }}</p>
    <div class="fem-cart__error" data-cart-error role="alert" hidden><span></span><button type="button" data-cart-retry>{{ 'fem_cart.retry' | t }}</button></div>
    <div class="fem-cart__scroll">
      <section class="fem-cart__shipping" data-cart-shipping hidden>
        <p data-cart-shipping-message></p>
        <div class="fem-cart__track" role="progressbar" aria-label="{{ 'fem_cart.shipping_progress' | t }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span data-cart-progress></span><b aria-hidden="true">★</b></div>
      </section>
      <div class="fem-cart__empty" data-cart-empty hidden><span aria-hidden="true">♡</span><h3>{{ 'fem_cart.empty' | t }}</h3><p>{{ 'fem_cart.empty_copy' | t }}</p><a href="{{ routes.all_products_collection_url }}">{{ 'fem_cart.explore' | t }}</a></div>
      <ul class="fem-cart__items" data-cart-items aria-label="{{ 'fem_cart.products' | t }}"></ul>
      {% if section.settings.show_gifts %}
        <div class="fem-cart__gifts" data-cart-gifts hidden>
          <div class="fem-cart__gift"><img src="{{ 'fem-cart-guide.jpg' | asset_url }}" width="80" height="51" loading="lazy" alt="{{ 'fem_cart.guide' | t }}"><span>{{ 'fem_cart.guide' | t }}</span><b>{{ 'fem_cart.free' | t }}</b></div>
          <div class="fem-cart__gift"><img src="{{ 'fem-cart-plan.png' | asset_url }}" width="80" height="51" loading="lazy" alt="{{ 'fem_cart.plan' | t }}"><span>{{ 'fem_cart.plan' | t }}</span><b>{{ 'fem_cart.free' | t }}</b></div>
        </div>
      {% endif %}
      <section class="fem-cart__suggestions" data-cart-suggestions hidden><h3>{{ 'fem_cart.suggestions' | t }}</h3><ul data-cart-recommendations></ul></section>
    </div>
    <footer class="fem-cart__footer" data-cart-footer hidden>
      <div class="fem-cart__ribbon"><span data-cart-promo>{{ 'fem_cart.secure' | t }}</span><span data-cart-countdown hidden></span></div>
      <div class="fem-cart__checkout"><div class="fem-cart__saving" data-cart-savings hidden></div><div class="fem-cart__total"><strong>{{ 'fem_cart.total' | t }}</strong><strong data-cart-total></strong></div><a class="fem-cart__pay" href="{{ routes.cart_url | replace: '/cart', '/checkout' }}" data-cart-checkout>{{ 'fem_cart.checkout' | t }}</a><div class="fem-cart__payments" data-cart-payments aria-label="{{ 'fem_cart.payments' | t }}">{% for payment in shop.enabled_payment_types limit: 7 %}<img src="{{ payment | payment_type_img_url }}" alt="{{ payment }}" width="38" height="24" loading="lazy">{% endfor %}</div></div>
    </footer>
  </div>
  <template data-cart-item-template><li class="fem-cart__item"><a data-item-url tabindex="-1" aria-hidden="true"><img data-item-image width="64" height="64" loading="lazy" alt=""></a><div class="fem-cart__item-info"><a class="fem-cart__item-title" data-item-url data-item-title></a><p class="fem-cart__variant" data-item-variant hidden></p><p class="fem-cart__price"><s data-item-original hidden></s> <span data-item-price></span></p><div class="fem-cart__quantity"><button type="button" data-cart-minus aria-label="{{ 'fem_cart.decrease' | t }}">−</button><input type="number" min="0" max="999" step="1" inputmode="numeric" data-cart-quantity aria-label="{{ 'fem_cart.quantity' | t }}"><button type="button" data-cart-plus aria-label="{{ 'fem_cart.increase' | t }}">+</button></div></div><button type="button" class="fem-cart__remove" data-cart-remove aria-label="{{ 'fem_cart.remove' | t }}">×</button></li></template>
  <template data-cart-recommendation-template><li class="fem-cart__recommendation"><a data-product-url tabindex="-1" aria-hidden="true"><img data-product-image width="48" height="48" loading="lazy" alt=""></a><div><a data-product-url data-product-title></a><p data-product-price></p></div><button type="button" data-cart-recommendation-add aria-label="{{ 'fem_cart.add' | t }}">+</button></li></template>
  <script type="application/json" data-cart-config>{"root":{{ routes.root_url | json }},"threshold":{{ section.settings.shipping_threshold | times: 100 | json }},"endsAt":{{ section.settings.promotion_end | json }},"labels":{"shippingRemaining":{{ 'fem_cart.shipping_remaining' | t | json }},"shippingReached":{{ 'fem_cart.shipping_reached' | t | json }},"loading":{{ 'fem_cart.loading' | t | json }},"updating":{{ 'fem_cart.updating' | t | json }},"updated":{{ 'fem_cart.updated' | t | json }},"saving":{{ 'fem_cart.saving' | t | json }},"promotion":{{ 'fem_cart.promotion' | t | json }}}}</script>
</dialog>
{% schema %}
{"name":"Carrito Fem","settings":[{"type":"number","id":"shipping_threshold","label":"Envío gratis desde (COP)","default":100000},{"type":"checkbox","id":"show_gifts","label":"Mostrar regalos al alcanzar el mínimo","default":true},{"type":"text","id":"promotion_end","label":"Fin real de promoción (fecha ISO)","info":"Opcional. Ejemplo: 2026-12-31T23:59:00-05:00. El contador solo aparece mientras esta fecha esté vigente."}]}
{% endschema %}
