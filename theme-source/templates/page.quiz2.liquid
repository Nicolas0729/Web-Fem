<script>
const Q = (() => {
  const STEPS = {intro:0, q1:15, q2:30, q3:60, q4:85, result:100};

  function setProg(pct) {
    document.getElementById('prog-fill').style.width = pct + '%';
    document.getElementById('prog-label').textContent = pct + '% completado';
    document.getElementById('prog').classList.toggle('show', pct > 0);
  }

  function show(id) {
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    const scr = document.getElementById('s-' + id);
    scr.classList.add('active');
    const inner = scr.querySelector('.intro-card,.q-card,.result-wrap');
    if (inner) {
      inner.classList.remove('anim-pop','anim-slide');
      void inner.offsetWidth;
      inner.classList.add(id === 'intro' ? 'anim-pop' : 'anim-slide');
    }
    setProg(STEPS[id] || 0);
    window.scrollTo({top:0, behavior:'smooth'});
  }

  function ripple(btn) {
    btn.classList.remove('rip');
    void btn.offsetWidth;
    btn.classList.add('rip');
    btn.addEventListener('animationend', () => btn.classList.remove('rip'), {once:true});
  }

  function pick(el) {
    const q = el.dataset.q, v = el.dataset.v;
    if (!q || !v) return;
    el.closest('.opts-list,.opts-grid')
      .querySelectorAll('.opt-row,.opt-card')
      .forEach(o => o.classList.remove('sel'));
    el.classList.add('sel');
    const btn = document.getElementById('b-' + q);
    if (btn) btn.disabled = false;
  }

  function price(id) {
    document.querySelectorAll('.price-opt').forEach(o => o.classList.remove('on'));
    const el = document.getElementById('po-' + id);
    if (el) el.classList.add('on');
  }

  function start(btn) { ripple(btn); setTimeout(() => show('q1'), 180); }
  function go(btn, n) { ripple(btn); setTimeout(() => show('q' + n), 180); }
  function result(btn) { ripple(btn); setTimeout(() => { show('result'); price('kit'); }, 180); }

  return { start, go, result, pick, price, ripple };
})();
</script>
