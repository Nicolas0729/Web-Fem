<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>FEM — Diagnóstico de Bienestar</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,600;0,700;0,800;1,600;1,700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<style>

:root {
  --coral:       #F04E4E;
  --coral-d:     #D93C3C;
  --coral-l:     #FF7070;
  --rose-50:     #FFF1F1;
  --rose-100:    #FFE4E4;
  --rose-200:    #FFCECE;
  --rose-300:    #FFB0B0;
  --ink-900:     #170808;
  --ink-700:     #3A1A1A;
  --ink-500:     #7A4A4A;
  --ink-300:     #C4A0A0;
  --ink-100:     #F2EAEA;
  --white:       #FFFFFF;
  --bg:          #FDF2F2;
  --gold:        #D4960A;
  --gold-bg:     #FFF7E0;
  --green:       #1A9956;
  --shadow-xs:   0 1px 3px rgba(200,50,50,0.06);
  --shadow-sm:   0 2px 8px rgba(200,50,50,0.08), 0 1px 3px rgba(200,50,50,0.05);
  --shadow-md:   0 4px 20px rgba(200,50,50,0.10), 0 2px 6px rgba(200,50,50,0.06);
  --shadow-btn:  0 4px 16px rgba(240,78,78,0.40);
  --r-s:  10px;
  --r-m:  18px;
  --r-l:  24px;
  --r-xl: 30px;
  --font-serif: 'Fraunces', Georgia, serif;
  --font-sans:  'Plus Jakarta Sans', system-ui, sans-serif;
  --ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
  --ease-out:    cubic-bezier(0.16, 1, 0.3, 1);
  --ease-std:    cubic-bezier(0.4, 0, 0.2, 1);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { -webkit-font-smoothing: antialiased; scroll-behavior: smooth; }
body { font-family: var(--font-sans); background: var(--bg); min-height: 100vh; overflow-x: hidden; color: var(--ink-700); }

/* ── Background blobs ── */
.bg-layer { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
.bg-blob { position: absolute; border-radius: 50%; filter: blur(100px); }
.bg-blob-1 { width:640px; height:640px; background:radial-gradient(circle,rgba(255,160,160,0.55) 0%,transparent 65%); top:-200px; right:-200px; animation:b1 16s ease-in-out infinite; }
.bg-blob-2 { width:480px; height:480px; background:radial-gradient(circle,rgba(255,200,140,0.40) 0%,transparent 65%); bottom:0; left:-150px; animation:b2 20s ease-in-out infinite; }
.bg-blob-3 { width:320px; height:320px; background:radial-gradient(circle,rgba(255,160,200,0.35) 0%,transparent 65%); top:40%; right:-100px; animation:b3 12s ease-in-out infinite; }
@keyframes b1 { 0%,100%{transform:translate(0,0) scale(1)} 50%{transform:translate(-50px,60px) scale(1.1)} }
@keyframes b2 { 0%,100%{transform:translate(0,0) scale(1)} 50%{transform:translate(60px,-40px) scale(0.9)} }
@keyframes b3 { 0%,100%{transform:translate(0,0)} 50%{transform:translate(-30px,40px)} }

/* ── Shell ── */
.shell { position:relative; z-index:1; display:flex; flex-direction:column; align-items:center; min-height:100vh; padding:0 16px 96px; }

/* ── Progress ── */
.prog-wrap { width:100%; max-width:540px; padding:24px 0 0; position:sticky; top:0; z-index:30; display:flex; flex-direction:column; gap:6px; opacity:0; transform:translateY(-4px); transition:opacity .5s var(--ease-std),transform .5s var(--ease-std); }
.prog-wrap.show { opacity:1; transform:translateY(0); }
.prog-track { height:4px; background:var(--rose-200); border-radius:99px; overflow:hidden; }
.prog-fill { height:100%; width:0%; background:linear-gradient(90deg,var(--coral-l),var(--coral)); border-radius:99px; transition:width .6s var(--ease-out); position:relative; }
.prog-fill::after { content:''; position:absolute; inset:0; background:linear-gradient(90deg,transparent 0%,rgba(255,255,255,.5) 50%,transparent 100%); background-size:200% 100%; animation:shimmer 2s ease-in-out infinite; }
@keyframes shimmer { 0%{background-position:200% 0} 100%{background-position:-200% 0} }
.prog-label { font-size:11px; font-weight:600; color:var(--ink-300); text-align:right; letter-spacing:.5px; text-transform:uppercase; }

/* ── Screens ── */
.screen { display:none; flex-direction:column; align-items:center; width:100%; max-width:540px; padding-top:24px; }
.screen.active { display:flex; }

@keyframes fadeSlide { from{opacity:0;transform:translateY(24px)} to{opacity:1;transform:translateY(0)} }
@keyframes scalePop { 0%{opacity:0;transform:scale(.92) translateY(16px)} 60%{transform:scale(1.01) translateY(-1px)} 100%{opacity:1;transform:scale(1) translateY(0)} }
.anim-slide { animation:fadeSlide .44s var(--ease-out) both; }
.anim-pop   { animation:scalePop .56s var(--ease-bounce) both; }

/* ══════════════════════════════════
   INTRO
══════════════════════════════════ */
.intro-card {
  background:var(--white);
  border-radius:var(--r-xl);
  padding:40px 32px 36px;
  width:100%;
  display:flex; flex-direction:column; align-items:center; text-align:center;
  gap:18px;
  box-shadow:var(--shadow-md);
  border:1px solid rgba(240,78,78,0.06);
}

/* ── Product image ─────────────────
   Solo un <img>. Si la URL carga → visible.
   Si falla o está vacía → oculto (sin placeholder extra).
   Reemplaza src con tu URL de producto.
─────────────────────────────────── */
.product-slot {
  position:relative;
  width:120px; height:160px;
  display:flex; align-items:center; justify-content:center;
  margin-bottom:4px;
}
.product-slot::before {
  content:'';
  position:absolute; inset:-14px;
  background:radial-gradient(circle,rgba(240,78,78,.15) 0%,transparent 68%);
  border-radius:50%;
  animation:glowPulse 3s ease-in-out infinite;
}
@keyframes glowPulse { 0%,100%{transform:scale(1);opacity:.8} 50%{transform:scale(1.3);opacity:1} }
@keyframes floatY    { 0%,100%{transform:translateY(0) rotate(0deg)} 50%{transform:translateY(-10px) rotate(.8deg)} }

.product-img {
  max-width:100%; max-height:100%;
  object-fit:contain;
  position:relative; z-index:1;
  filter:drop-shadow(0 12px 28px rgba(240,78,78,.28));
  animation:floatY 4.5s ease-in-out infinite;
}

.intro-eyebrow { display:inline-flex; align-items:center; gap:6px; background:var(--gold-bg); color:var(--gold); font-size:12px; font-weight:700; padding:6px 16px; border-radius:99px; letter-spacing:.4px; border:1px solid rgba(212,150,10,.18); }
.intro-title { font-family:var(--font-serif); font-size:30px; font-weight:700; color:var(--coral); line-height:1.16; letter-spacing:-.4px; }
.intro-title em { font-style:italic; font-weight:600; }
.intro-body { font-size:14px; font-weight:400; color:var(--ink-500); line-height:1.72; max-width:290px; }

.intro-meta { display:flex; align-items:center; gap:6px; justify-content:center; flex-wrap:wrap; }
.intro-meta-item { display:flex; align-items:center; gap:5px; font-size:12px; font-weight:500; color:var(--ink-300); padding:5px 12px; background:var(--rose-50); border-radius:99px; }
.meta-sep { width:3px; height:3px; border-radius:50%; background:var(--rose-300); }
.intro-lock { font-size:11.5px; color:var(--ink-300); margin-top:-4px; }

/* ══════════════════════════════════
   QUESTION CARD
══════════════════════════════════ */
.q-card { background:var(--white); border-radius:var(--r-l); padding:32px 28px 28px; width:100%; box-shadow:var(--shadow-md); border:1px solid rgba(240,78,78,.05); display:flex; flex-direction:column; }
.q-step-badge { display:inline-flex; align-items:center; gap:6px; background:var(--rose-100); color:var(--coral); font-size:11.5px; font-weight:700; padding:5px 12px; border-radius:99px; letter-spacing:.3px; margin-bottom:14px; width:fit-content; }
.q-title { font-family:var(--font-serif); font-size:22px; font-weight:700; color:var(--ink-900); line-height:1.3; margin-bottom:6px; }
.q-title .hi { color:var(--coral); font-style:italic; }
.q-sub { font-size:12.5px; color:var(--ink-300); margin-bottom:22px; }

/* Row options — Q1 */
.opts-list { display:flex; flex-direction:column; gap:10px; }
.opt-row { display:flex; align-items:center; gap:14px; background:var(--white); border:1.5px solid var(--ink-100); border-radius:var(--r-m); padding:15px 16px; cursor:pointer; user-select:none; -webkit-tap-highlight-color:transparent; transition:border-color .2s,background .2s,transform .3s var(--ease-bounce),box-shadow .2s; }
.opt-row:hover { border-color:var(--rose-300); background:var(--rose-50); transform:translateX(3px); }
.opt-row.sel { border-color:var(--coral); background:var(--rose-50); box-shadow:0 0 0 3px rgba(240,78,78,.09); transform:translateX(5px); }
.opt-row-icon { width:48px; height:48px; min-width:48px; background:var(--rose-100); border-radius:13px; display:flex; align-items:center; justify-content:center; font-size:23px; transition:transform .3s var(--ease-bounce),background .2s; }
.opt-row.sel .opt-row-icon { transform:scale(1.14) rotate(-5deg); background:var(--rose-200); }
.opt-row-body { flex:1; display:flex; flex-direction:column; gap:2px; }
.opt-row-label { font-size:14.5px; font-weight:700; color:var(--ink-900); }
.opt-row-desc  { font-size:11.5px; color:var(--ink-300); line-height:1.5; }
.opt-row-radio { width:20px; height:20px; min-width:20px; border-radius:50%; border:2px solid var(--ink-100); display:flex; align-items:center; justify-content:center; transition:border-color .2s,background .2s; flex-shrink:0; }
.opt-row.sel .opt-row-radio { border-color:var(--coral); background:var(--coral); }
.opt-row-radio-dot { width:7px; height:7px; border-radius:50%; background:#fff; transform:scale(0); transition:transform .2s var(--ease-bounce); }
.opt-row.sel .opt-row-radio-dot { transform:scale(1); }

/* Card options — Q2, Q3, Q4 */
.opts-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }
.opt-card { display:flex; flex-direction:column; align-items:center; text-align:center; background:var(--white); border:1.5px solid var(--ink-100); border-radius:var(--r-m); padding:20px 10px 16px; cursor:pointer; user-select:none; -webkit-tap-highlight-color:transparent; gap:8px; transition:border-color .2s,background .2s,transform .3s var(--ease-bounce),box-shadow .2s; }
.opt-card:hover { border-color:var(--rose-300); background:var(--rose-50); transform:translateY(-4px); }
.opt-card.sel { border-color:var(--coral); background:var(--rose-50); box-shadow:0 8px 24px rgba(240,78,78,.15); transform:translateY(-6px); }
.opt-card-icon { width:66px; height:66px; background:var(--rose-100); border-radius:16px; display:flex; align-items:center; justify-content:center; font-size:32px; transition:transform .3s var(--ease-bounce),background .2s; }
.opt-card.sel .opt-card-icon { transform:scale(1.1) rotate(-6deg); background:var(--rose-200); }
.opt-card-label { font-size:13px; font-weight:700; color:var(--ink-900); }
.opt-card-desc  { font-size:10.5px; color:var(--ink-300); line-height:1.5; }
.opt-card-pip { width:6px; height:6px; border-radius:50%; background:var(--ink-100); margin-top:2px; transition:background .2s,transform .3s var(--ease-bounce); }
.opt-card.sel .opt-card-pip { background:var(--coral); transform:scale(1.6); }
.q-hint { font-size:11.5px; color:var(--ink-300); margin-top:14px; font-style:italic; }

/* Main button */
.btn-main { width:100%; height:54px; background:var(--coral); color:#fff; border:none; border-radius:var(--r-m); font-size:15px; font-weight:700; letter-spacing:.2px; cursor:pointer; margin-top:24px; display:flex; align-items:center; justify-content:center; gap:8px; position:relative; overflow:hidden; box-shadow:var(--shadow-btn); transition:background .18s,transform .18s,box-shadow .18s; -webkit-tap-highlight-color:transparent; }
.btn-main:hover:not(:disabled) { background:var(--coral-d); box-shadow:0 6px 24px rgba(240,78,78,.5); transform:translateY(-1px); }
.btn-main:active:not(:disabled) { transform:scale(.977); }
.btn-main:disabled { background:var(--rose-300); box-shadow:none; cursor:not-allowed; }
.btn-arrow { display:inline-flex; align-items:center; transition:transform .2s var(--ease-out); }
.btn-main:hover:not(:disabled) .btn-arrow { transform:translateX(4px); }

@keyframes ripOut { to{transform:translate(-50%,-50%) scale(1);opacity:0} }
.btn-main.rip::after,.btn-cta.rip::after { content:''; position:absolute; width:250%; height:250%; background:rgba(255,255,255,.2); border-radius:50%; top:50%; left:50%; transform:translate(-50%,-50%) scale(0); animation:ripOut .55s ease-out forwards; pointer-events:none; }

/* ══════════════════════════════════
   RESULT
══════════════════════════════════ */
.result-wrap { width:100%; max-width:460px; display:flex; flex-direction:column; gap:14px; }

@keyframes revealUp { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }
.rv { animation:revealUp .5s var(--ease-out) var(--d,0s) both; }

.result-header { display:flex; flex-direction:column; align-items:center; text-align:center; gap:10px; }
.result-pill { display:inline-flex; align-items:center; gap:6px; background:var(--rose-100); color:var(--coral); font-size:11.5px; font-weight:700; padding:5px 14px; border-radius:99px; }
.result-title { font-family:var(--font-serif); font-size:26px; font-weight:700; color:var(--ink-900); line-height:1.22; }
.result-title em { color:var(--coral); font-style:italic; }

/* Diagnostic card */
.diag-card { background:var(--white); border-radius:var(--r-m); padding:22px; box-shadow:var(--shadow-sm); border:1px solid var(--ink-100); }
.diag-header { display:flex; align-items:center; gap:14px; padding-bottom:16px; border-bottom:1px solid var(--ink-100); margin-bottom:16px; }
.diag-icon-box { width:50px; height:50px; min-width:50px; background:var(--rose-100); border-radius:13px; display:flex; align-items:center; justify-content:center; font-size:26px; }
.diag-name { font-size:15px; font-weight:700; color:var(--ink-900); margin-bottom:4px; }
.diag-level { display:flex; align-items:center; gap:6px; font-size:12px; font-weight:500; color:var(--ink-500); }
.diag-dot { width:7px; height:7px; border-radius:50%; background:var(--coral); animation:dotPulse 2s ease-in-out infinite; }
@keyframes dotPulse { 0%,100%{transform:scale(1);opacity:1} 50%{transform:scale(1.7);opacity:.5} }
.diag-list { list-style:none; display:flex; flex-direction:column; gap:10px; }
.diag-list li { display:flex; align-items:flex-start; gap:10px; font-size:13px; color:var(--ink-700); line-height:1.55; }
.ck { color:var(--coral); font-weight:700; font-size:14px; flex-shrink:0; }

/* Product card */
.prod-card { background:var(--white); border-radius:var(--r-m); overflow:hidden; box-shadow:var(--shadow-sm); border:1px solid var(--ink-100); }
.prod-banner { background:linear-gradient(165deg,#FFD4D4 0%,#FFC0C0 50%,#FFABAB 100%); padding:24px 20px 20px; display:flex; flex-direction:column; align-items:center; gap:14px; position:relative; overflow:hidden; }
.prod-banner::before { content:''; position:absolute; width:300px; height:300px; border-radius:50%; background:rgba(255,255,255,.12); bottom:-120px; right:-60px; }
.prod-rec-pill { background:var(--white); color:var(--coral); font-size:11px; font-weight:800; padding:5px 14px; border-radius:99px; letter-spacing:.5px; text-transform:uppercase; box-shadow:0 2px 8px rgba(240,78,78,.2); }

/* ── Product image in result ──
   Solo un <img>. Sin placeholder extra.
   Reemplaza src con tu URL.
────────────────────────────── */
.prod-img-slot {
  width:110px; height:170px;
  display:flex; align-items:center; justify-content:center;
  position:relative; z-index:1;
}
.prod-img {
  max-width:100%; max-height:100%;
  object-fit:contain;
  filter:drop-shadow(0 12px 28px rgba(180,0,0,.25));
  animation:floatY 4.5s ease-in-out infinite;
}

.prod-body { padding:22px; }
.prod-name { font-family:var(--font-serif); font-size:19px; font-weight:700; color:var(--ink-900); margin-bottom:6px; }
.prod-desc { font-size:12.5px; color:var(--ink-500); line-height:1.65; margin-bottom:16px; }
.ben-list { list-style:none; display:flex; flex-direction:column; gap:8px; margin-bottom:22px; }
.ben-list li { display:flex; align-items:flex-start; gap:9px; font-size:12.5px; color:var(--ink-700); line-height:1.5; }
.prod-divider { height:1px; background:var(--ink-100); margin:0 0 20px; }

/* ══════════════════════════════════
   PRICING — clean, minimal
══════════════════════════════════ */
.pricing-wrap {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 20px;
}

.price-opt {
  border: 1.5px solid var(--ink-100);
  border-radius: var(--r-m);
  padding: 16px 18px;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  transition: border-color .2s, background .2s, box-shadow .2s;
}
.price-opt:hover { border-color: var(--rose-300); background: var(--rose-50); }
.price-opt.on {
  border-color: var(--coral);
  background: var(--rose-50);
  box-shadow: 0 0 0 3px rgba(240,78,78,.08);
}

/* Featured ribbon */
.price-opt-featured { padding-top: 34px; }
.price-stripe {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 22px;
  background: var(--coral);
  display: flex; align-items: center; justify-content: center;
  font-size: 9px; font-weight: 800;
  color: #fff; letter-spacing: 1.2px; text-transform: uppercase;
}

.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

/* Left: name + subtitle */
.price-left {}
.price-name {
  font-size: 14px;
  font-weight: 600;
  color: var(--ink-900);
  margin-bottom: 2px;
  line-height: 1.2;
}
.price-sub {
  font-size: 11px;
  font-weight: 400;
  color: var(--ink-300);
  line-height: 1.3;
}

/* Right: prices stacked */
.price-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  gap: 1px;
}
.price-was {
  font-size: 11px;
  font-weight: 400;
  color: var(--ink-300);
  text-decoration: line-through;
}
.price-now {
  font-family: var(--font-serif);
  font-size: 20px;
  font-weight: 700;
  color: var(--ink-900);
  line-height: 1;
}

/* Savings row — slim */
.savings-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F0FAF4;
  border: 1px solid #B8E6CE;
  border-radius: var(--r-s);
  padding: 10px 14px;
  margin-bottom: 18px;
}
.savings-row-label {
  font-size: 12px;
  font-weight: 500;
  color: var(--green);
}
.savings-row-amount {
  font-family: var(--font-serif);
  font-size: 16px;
  font-weight: 700;
  color: var(--green);
}

/* CTA */
.btn-cta { width:100%; background:var(--coral); color:#fff; border:none; border-radius:var(--r-m); padding:0; height:56px; font-size:14px; font-weight:800; letter-spacing:.5px; text-transform:uppercase; cursor:pointer; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px; position:relative; overflow:hidden; box-shadow:var(--shadow-btn); margin-bottom:14px; transition:background .18s,transform .18s,box-shadow .18s; -webkit-tap-highlight-color:transparent; }
.btn-cta-sub { font-size:11px; font-weight:400; opacity:.8; text-transform:none; letter-spacing:.1px; }
.btn-cta:hover { background:var(--coral-d); transform:translateY(-2px); box-shadow:0 8px 28px rgba(240,78,78,.52); }
.btn-cta:active { transform:scale(.977); }

.trust-row { display:flex; justify-content:center; flex-wrap:wrap; }
.trust-item { display:flex; align-items:center; gap:5px; font-size:11px; color:var(--ink-300); padding:4px 12px; border-right:1px solid var(--ink-100); }
.trust-item:last-child { border-right:none; }

/* Reviews */
.reviews-section { display:flex; flex-direction:column; gap:10px; }
.reviews-eyebrow { font-size:12px; font-weight:600; color:var(--ink-300); text-align:center; letter-spacing:.3px; text-transform:uppercase; }
.review-card { background:var(--white); border-radius:var(--r-m); padding:18px 20px; box-shadow:var(--shadow-xs); border:1px solid var(--ink-100); }
.review-top { display:flex; align-items:center; gap:12px; margin-bottom:12px; }
.review-avatar { width:38px; height:38px; border-radius:50%; background:var(--rose-100); color:var(--coral); font-size:13px; font-weight:800; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.review-name  { font-size:13.5px; font-weight:700; color:var(--ink-900); }
.review-place { font-size:11px; color:var(--ink-300); margin-top:1px; }
.review-stars { margin-left:auto; color:var(--gold); font-size:14px; letter-spacing:1px; }
.review-text  { font-size:13px; color:var(--ink-500); line-height:1.68; font-style:italic; }

/* Responsive */
@media (max-width:520px) {
  .intro-card { padding:32px 20px 28px; }
  .intro-title { font-size:26px; }
  .q-card { padding:24px 18px 22px; }
  .q-title { font-size:19px; }
  .opts-grid { gap:7px; }
  .opt-card { padding:14px 7px 12px; }
