  /* =========================================================
     4) UTILIDADES
     ========================================================= */
  function $(id){ return document.getElementById(id); }
  function money(n){
    if(typeof n !== 'number' || !isFinite(n)) return '';
    return '$' + Math.round(n).toLocaleString('es-CO');
  }
  function esc(s){
    return String(s == null ? '' : s)
      .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
      .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  }
  function track(name, data){
    try{
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push(Object.assign({ event:name }, data || {}));
    }catch(e){}
  }
  function scrollTop(){
    try{ window.scrollTo({ top:0, behavior:'smooth' }); }
    catch(e){ window.scrollTo(0,0); }
  }
  function showScreen(id){
    ['scWelcome','scQuestion','scLoading','scResults'].forEach(function(s){
      var el = $(s); if(el) el.classList.toggle('is-active', s === id);
    });
    scrollTop();
  }
  function flow(){ return state.category ? FLOWS[state.category] : null; }
  function totalSteps(){ var f = flow(); return f ? f.questions.length + 1 : 1; }

  function setProgress(){
    var pct, label;
    if(state.done){ pct = 100; label = 'Tu resultado'; }
    else if(!state.category){ pct = 6; label = 'Empecemos'; }
    else{
      var t = totalSteps();
      pct = Math.round(((state.index + 1) / t) * 92) + 6;
      label = 'Paso ' + (state.index + 2) + ' de ' + t;
    }
    pct = Math.max(0, Math.min(100, pct));
    var f = $('pFill'), p = $('pPct'), s = $('pStep');
    if(f) f.style.width = pct + '%';
    if(p) p.textContent = pct;
    if(s) s.textContent = label;
  }

