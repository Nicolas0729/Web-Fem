      html += '<button type="button" class="opt" role="radio" aria-checked="false" data-cat="' + esc(c.id) + '">' +
                '<span class="opt-ico">' + c.icon + '</span>' +
                '<span class="opt-txt"><span class="ot">' + esc(c.title) + '</span><span class="od">' + esc(c.desc) + '</span></span>' +
                '<span class="check is-radio"></span>' +
              '</button>';
    });
    html += '</div>';
    html += '<div class="nav-row"><button type="button" class="btn-ghost" data-act="home">← Volver al inicio</button></div>';

    var wrap = $('scQuestion');
    wrap.innerHTML = html;
    wrap.querySelectorAll('[data-cat]').forEach(function(btn){
      btn.addEventListener('click', function(){
        wrap.querySelectorAll('.opt').forEach(function(o){ o.classList.remove('is-selected'); o.setAttribute('aria-checked','false'); });
        btn.classList.add('is-selected'); btn.setAttribute('aria-checked','true');
        var cat = btn.getAttribute('data-cat');
        setTimeout(function(){ startFlow(cat); }, 220);
      });
    });
    var home = wrap.querySelector('[data-act="home"]');
    if(home) home.addEventListener('click', resetQuiz);

    state.index = -1;
    showScreen('scQuestion');
    setProgress();
  }

  function startFlow(cat){
    if(!FLOWS[cat]) return;
    state.category = cat;
    state.answers = {};
    state.plan = 0;
    state.index = 0;
    track('quiz_category', { quiz_category: cat });
    renderQuestion();
  }

  /* =========================================================
     6) PREGUNTAS
     ========================================================= */
  function renderQuestion(){
    var f = flow();
    if(!f){ renderCategory(); return; }
    if(state.index < 0){ renderCategory(); return; }
    if(state.index >= f.questions.length){ runLoading(); return; }

    var q = f.questions[state.index];
    var stepNo = state.index + 2;
    var total = totalSteps();
    var html = '';

    html += '<div class="q-head">';
    html += '<span class="q-tag">' + esc(q.tag || f.icon) + ' · Pregunta ' + stepNo + ' de ' + total + '</span>';
    html += '<h2 class="q-title">' + (q.title || '') + '</h2>';
    if(q.sub) html += '<p class="q-sub">' + esc(q.sub) + '</p>';
    html += '</div>';

    if(q.type === 'multi' || q.type === 'single'){
      var picked = state.answers[q.id];
      html += '<div class="opts" role="' + (q.type === 'multi' ? 'group' : 'radiogroup') + '">';
      (q.options || []).forEach(function(o){
        var on = q.type === 'multi'
          ? (Array.isArray(picked) && picked.indexOf(o.value) > -1)
          : (picked === o.value);
        html += '<button type="button" class="opt' + (on ? ' is-selected' : '') + '" data-val="' + esc(o.value) + '">' +
                  '<span class="opt-ico">' + (o.icon || '•') + '</span>' +
                  '<span class="opt-txt"><span class="ot">' + esc(o.label) + '</span>' + (o.desc ? '<span class="od">' + esc(o.desc) + '</span>' : '') + '</span>' +
                  '<span class="check' + (q.type === 'single' ? ' is-radio' : '') + '"></span>' +
                '</button>';
      });
      html += '</div>';
    }
    else if(q.type === 'grid'){
      var pick = state.answers[q.id];
      html += '<div class="opts-grid">';
      (q.options || []).forEach(function(o){
        html += '<button type="button" class="opt-card' + (pick === o.value ? ' is-selected' : '') + '" data-val="' + esc(o.value) + '">' +
                  '<span class="ico">' + (o.icon || '•') + '</span>' +
                  '<span class="ot">' + esc(o.label) + '</span>' + (o.desc ? '<span class="od">' + esc(o.desc) + '</span>' : '') +
                '</button>';
      });
      html += '</div>';
    }
    else if(q.type === 'scale'){
      var sc = q.scale || SCALE_DEFAULT;
      var cur = state.answers[q.id];
      html += '<div class="scale"><div class="scale-row" role="radiogroup">';
      sc.forEach(function(o){
        html += '<button type="button" class="scale-opt' + (cur === o.value ? ' is-selected' : '') + '" data-val="' + o.value + '">' +
                  '<span class="emo">' + o.emoji + '</span><span class="lb">' + esc(o.label) + '</span>' +
                '</button>';
      });
      html += '</div></div>';
    }

    if(q.hint){
      html += '<div class="hint"><span class="i">💡</span><p>' + esc(q.hint) + '</p></div>';
    }

    var needsButton = (q.type === 'multi' || q.type === 'scale');
    html += '<div class="nav-row">';
    html += '<button type="button" class="btn-ghost" data-act="back">← Atrás</button>';
    if(needsButton){
      var last = state.index === f.questions.length - 1;
      html += '<button type="button" class="btn" data-act="next" disabled>' + (last ? 'Ver mi diagnóstico →' : 'Continuar →') + '</button>';
    }
    html += '</div>';

    var wrap = $('scQuestion');
    wrap.innerHTML = html;

    var nextBtn = wrap.querySelector('[data-act="next"]');
    function refreshNext(){
      if(!nextBtn) return;
      var v = state.answers[q.id];
      var ok = q.type === 'multi' ? (Array.isArray(v) && v.length > 0) : (v !== undefined && v !== null);
      nextBtn.disabled = !ok;
    }
    refreshNext();

    wrap.querySelectorAll('[data-val]').forEach(function(btn){
      btn.addEventListener('click', function(){
        var raw = btn.getAttribute('data-val');
        if(q.type === 'multi'){
          var arr = Array.isArray(state.answers[q.id]) ? state.answers[q.id].slice() : [];
          var i = arr.indexOf(raw);
          if(i > -1) arr.splice(i,1); else arr.push(raw);
          state.answers[q.id] = arr;
          btn.classList.toggle('is-selected');
          refreshNext();
        }
        else if(q.type === 'scale'){
          state.answers[q.id] = parseInt(raw,10);
          wrap.querySelectorAll('.scale-opt').forEach(function(o){ o.classList.remove('is-selected'); });
          btn.classList.add('is-selected');
          refreshNext();
        }
        else{
          state.answers[q.id] = raw;
          wrap.querySelectorAll('.opt, .opt-card').forEach(function(o){ o.classList.remove('is-selected'); });
          btn.classList.add('is-selected');
          setTimeout(goNext, 220);
        }
      });
    });

    if(nextBtn) nextBtn.addEventListener('click', goNext);
    var backBtn = wrap.querySelector('[data-act="back"]');
    if(backBtn) backBtn.addEventListener('click', goBack);

    showScreen('scQuestion');
    setProgress();
    track('quiz_question', { quiz_category: state.category, quiz_step: stepNo, quiz_question: q.id });
  }

  function goNext(){
    var f = flow(); if(!f) return;
    state.index++;
    if(state.index >= f.questions.length) runLoading();
    else renderQuestion();
  }
  function goBack(){
    if(state.index <= 0){ state.category = null; renderCategory(); return; }
    state.index--;
    renderQuestion();
  }

  /* =========================================================
     7) CARGANDO
     ========================================================= */
  var loadTimers = [];
  function clearTimers(){ loadTimers.forEach(clearTimeout); loadTimers = []; }

  function runLoading(){
    clearTimers();
    ['ls0','ls1','ls2'].forEach(function(id){
      var el = $(id); if(el) el.className = 'load-step';
    });
    showScreen('scLoading');
    state.done = false;
    setProgress();

    [0,1,2].forEach(function(i){
      loadTimers.push(setTimeout(function(){
        var el = $('ls' + i); if(el) el.classList.add('is-active');
      }, i * 620));
      loadTimers.push(setTimeout(function(){
        var el = $('ls' + i); if(el){ el.classList.remove('is-active'); el.classList.add('is-done'); }
      }, (i + 1) * 620));
    });
    loadTimers.push(setTimeout(renderResults, 2100));
  }

  /* =========================================================
     8) RESULTADOS
     ========================================================= */
  function collectSymptoms(){
    var f = flow(); if(!f) return [];
    var out = [];
    f.questions.forEach(function(q){
      if(q.type !== 'multi') return;
      var picked = state.answers[q.id];
      if(!Array.isArray(picked)) return;
      picked.forEach(function(v){
        (q.options || []).forEach(function(o){ if(o.value === v) out.push(o); });
      });
    });
    return out;
  }

  function severityValue(){
    var v = state.answers.severidad;
    if(typeof v === 'number' && v >= 1 && v <= 5) return v;
    return 3;
  }

  function collectChoiceInsights(){
    var f = flow(); if(!f) return [];
    var out = [];
    f.questions.forEach(function(q){
      if(q.type !== 'single' && q.type !== 'grid') return;
      var v = state.answers[q.id];
      if(v === undefined || v === null) return;
      (q.options || []).forEach(function(o){ if(o.value === v && o.insight) out.push(o.insight); });
    });
    return out;
  }

  // Evita que dos hallazgos digan casi lo mismo
  function words(s){
    return String(s).toLowerCase().replace(/<[^>]+>/g,' ')
      .replace(/[^a-záéíóúüñ ]/g,' ').split(/\s+/)
      .filter(function(w){ return w.length > 4; });
  }
  function tooSimilar(a, b){
    var A = words(a), B = words(b);
    if(!A.length || !B.length) return false;
    var hits = 0;
    A.forEach(function(w){ if(B.indexOf(w) > -1) hits++; });
    return hits / Math.min(A.length, B.length) >= 0.55;
  }
  function pushLine(lines, text){
    for(var i=0;i<lines.length;i++){ if(tooSimilar(lines[i], text)) return; }
    lines.push(text);
  }

  function buildFindings(){
    var f = flow(); if(!f) return [];
    var picked = collectSymptoms();
    var lines = [];

    picked.slice(0,3).forEach(function(o){
      if(o.insight) pushLine(lines, o.insight + '.');
    });
    var extra = picked.length ? 2 : 3;
    collectChoiceInsights().forEach(function(t){
      if(lines.length >= (picked.length ? Math.min(picked.length,3) : 0) + extra) return;
      pushLine(lines, t + '.');
    });

    var sev = severityValue();
    if(sev >= 4) lines.push('Marcaste un impacto <b>alto</b> en tu día a día: es momento de atacar la causa, no solo el síntoma.');
    else if(sev === 3) lines.push('El impacto en tu rutina es <b>moderado</b>, un buen momento para actuar antes de que aumente.');
    else lines.push('Tus molestias todavía son <b>manejables</b>: actuar ahora es la mejor forma de evitar que crezcan.');

    if(f.closing) lines.push(f.closing);
    return lines;
  }

  function planIndexDefault(f){
    var idx = 0;
    (f.plans || []).forEach(function(p,i){ if(p.recommended) idx = i; });
    return idx;
  }

  function renderResults(){
    var f = flow();
    if(!f){ resetQuiz(); return; }

    state.done = true;
    state.plan = planIndexDefault(f);

    var picked = collectSymptoms();
    var sev = severityValue();
    var findings = buildFindings();
    var p = f.product;
    var html = '';

    /* --- encabezado --- */
    html += '<div class="res-head">';
    html += '<span class="pill">🌸 Tu diagnóstico personalizado</span>';
    html += '<h1>Esto es lo que <span>necesita tu cuerpo</span></h1>';
    html += '</div>';

    /* --- diagnóstico --- */
    html += '<div class="card">';
    html += '<div class="diag-top">';
    html += '<div class="diag-ico">' + (f.icon || '🌸') + '</div>';
    html += '<div class="diag-txt"><h3>' + esc(f.diagnosisTitle) + '</h3><p>Según las respuestas que nos diste</p></div>';
    html += '</div>';

    html += '<div class="meter"><div class="meter-head"><b>Nivel detectado</b><span>' + esc(SEVERITY_WORDS[sev-1]) + '</span></div><div class="meter-bars">';
    for(var i=1;i<=5;i++) html += '<i class="' + (i <= sev ? 'on' : '') + '"></i>';
    html += '</div></div>';

    if(picked.length){
      html += '<div class="chips">';
      picked.forEach(function(o){ html += '<span class="chip">' + esc(o.label) + '</span>'; });
      html += '</div>';
    }

    html += '<ul class="findings">';
    findings.forEach(function(l){ html += '<li><span>' + l + '</span></li>'; });
    html += '</ul>';
    html += '</div>';

    /* --- recomendación --- */
    html += '<div class="rec">';
    html += '<span class="rec-badge">💡 RECOMENDADO PARA TI</span>';
    html += '<div class="product">';
    html += '<div class="product-media">';
    html += '<img id="resImg" src="" alt="' + esc(p.name) + '" loading="lazy" decoding="async">';
    html += '<span class="save-badge" id="resSave" hidden></span>';
    html += '</div>';
    html += '<div class="product-body">';
    html += '<h2>' + esc(p.name) + '</h2>';
    html += '<p class="desc">' + esc(p.desc) + '</p>';
    html += '<div class="benefits">';
    (p.benefits || []).forEach(function(b){ html += '<div class="benefit"><i>✓</i><span>' + esc(b) + '</span></div>'; });
    html += '</div>';

    if((f.plans || []).length > 1){
      html += '<p class="plans-title">Elige tu plan</p><div class="plans" role="radiogroup">';
      f.plans.forEach(function(pl,i){
        html += '<div class="plan" role="radio" tabindex="0" aria-checked="false" data-plan="' + i + '">' +
                  '<div class="plan-top">' +
                    '<span class="plan-radio"></span>' +
                    '<span class="plan-main">' +
                      (pl.tag ? '<span class="plan-tag">' + esc(pl.tag) + '</span>' : '') +
                      '<span class="plan-name">' + esc(pl.name) + '</span>' +
                      (pl.desc ? '<span class="plan-desc">' + esc(pl.desc) + '</span>' : '') +
                    '</span>' +
                    '<span class="plan-price">' +
                      (pl.oldPrice && pl.oldPrice > pl.price ? '<s>' + money(pl.oldPrice) + '</s>' : '') +
                      '<b>' + money(pl.price) + '</b>' +
                    '</span>' +
                  '</div>' +
                '</div>';
      });
      html += '</div>';
    }

    html += '<div class="summary">';
    html += '<p class="lbl" id="resPlanName"></p>';
    html += '<div class="prices"><s id="resOld" hidden></s><strong id="resNew"></strong></div>';
    html += '<span class="save" id="resSaving" hidden></span>';
    html += '</div>';

    html += '<button type="button" class="btn-cta" id="btnCta"><span class="t">LO QUIERO AHORA</span><span class="s">Envío gratis · Pagas al recibir</span></button>';
    html += '<div class="trust"><span>🚚 Envío gratis</span><span>💳 Pagas al recibir</span><span>🇨🇴 Hecho en Colombia</span></div>';
    html += '</div></div>';

    /* --- testimonio --- */
    if(f.testimonial){
      html += '<div class="tst"><h3 class="tst-title">⭐ Lo que dicen nuestras clientas</h3>';
      html += '<div class="tst-card"><div class="tst-top"><div class="tst-av">👩</div><div><h4>' + esc(f.testimonial.name) + '</h4><p>' + esc(f.testimonial.place) + ', Colombia</p></div></div>';
      html += '<div class="stars">★★★★★</div><p class="tst-text">' + esc(f.testimonial.text) + '</p></div></div>';
    }

    html += '<div class="restart"><button type="button" class="btn-ghost" id="btnRestart">↺ Repetir el diagnóstico</button></div>';
    html += '<p class="legal">Este diagnóstico es orientativo y no reemplaza una consulta médica. Si tus síntomas persisten, consulta a tu profesional de salud.</p>';
    html += '</div>';

    var wrap = $('scResults');
    wrap.innerHTML = html;

    wrap.querySelectorAll('[data-plan]').forEach(function(el){
      el.addEventListener('click', function(){ selectPlan(parseInt(el.getAttribute('data-plan'),10)); });
      el.addEventListener('keydown', function(e){
        if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); selectPlan(parseInt(el.getAttribute('data-plan'),10)); }
      });
    });

    var cta = $('btnCta');
    if(cta) cta.addEventListener('click', goToCheckout);
    var rs = $('btnRestart');
    if(rs) rs.addEventListener('click', resetQuiz);

    selectPlan(state.plan, true);
    showScreen('scResults');
    setProgress();

    track('quiz_complete', {
      quiz_category: state.category,
      quiz_severity: sev,
      quiz_symptoms: picked.map(function(o){ return o.value; }).join('|')
    });
  }

  function selectPlan(i, silent){
    var f = flow(); if(!f) return;
    var plans = f.plans || [];
    if(!plans.length) return;
    if(isNaN(i) || i < 0 || i >= plans.length) i = 0;
    state.plan = i;
    var pl = plans[i];

    document.querySelectorAll('#scResults [data-plan]').forEach(function(el){
      var on = parseInt(el.getAttribute('data-plan'),10) === i;
      el.classList.toggle('is-selected', on);
      el.setAttribute('aria-checked', on ? 'true' : 'false');
    });

    var img = $('resImg');
    if(img){
      var src = pl.image || f.product.image || '';
      if(src && img.getAttribute('src') !== src) img.setAttribute('src', src);
    }

    var name = $('resPlanName');
    if(name) name.textContent = pl.name;

    var oldEl = $('resOld'), newEl = $('resNew'), saveEl = $('resSaving'), badge = $('resSave');
    var hasOld = pl.oldPrice && pl.oldPrice > pl.price;

    if(newEl) newEl.textContent = money(pl.price);
    if(oldEl){ oldEl.textContent = hasOld ? money(pl.oldPrice) : ''; oldEl.hidden = !hasOld; }
    if(saveEl){
      saveEl.textContent = hasOld ? '¡Ahorras ' + money(pl.oldPrice - pl.price) + '!' : '';
      saveEl.hidden = !hasOld;
    }
    if(badge){
      if(hasOld){
        badge.textContent = '-' + Math.round((1 - pl.price / pl.oldPrice) * 100) + '%';
        badge.hidden = false;
      }else{
        badge.hidden = true;
      }
    }

    if(!silent) track('quiz_select_plan', { quiz_category: state.category, quiz_plan: pl.name, value: pl.price });
  }

  function goToCheckout(){
    var f = flow(); if(!f) return;
    var pl = (f.plans || [])[state.plan];
    if(!pl || !pl.url) return;

    var cta = $('btnCta');
    if(cta){
      if(cta.disabled) return;
      cta.disabled = true;
      var t = cta.querySelector('.t');
      if(t) t.textContent = 'Llevándote al carrito…';
    }
    track('quiz_cta_click', { quiz_category: state.category, quiz_plan: pl.name, value: pl.price });
    setTimeout(function(){ window.location.href = pl.url; }, 120);
  }

  /* =========================================================
     9) REINICIO / ARRANQUE
     ========================================================= */
  function resetQuiz(){
    clearTimers();
    state = { category:null, index:0, answers:{}, plan:0, done:false };
    showScreen('scWelcome');
    setProgress();
  }

  var start = $('btnStart');
  if(start) start.addEventListener('click', function(){
    track('quiz_start', {});
    state.category = null;
    renderCategory();
  });

  // Precarga discreta de las imágenes de producto
  setTimeout(function(){
    [IMG.vaginal, IMG.pms, IMG.mom].forEach(function(u){ var i = new Image(); i.src = u; });
  }, 1200);

  setProgress();
})();
</script>

