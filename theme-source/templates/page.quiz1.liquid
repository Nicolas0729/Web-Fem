<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex">
<title>Diagnóstico de Bienestar | Fem</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --primary:#ED5340;
  --primary-dark:#D14330;
  --primary-light:#FF9DA3;
  --primary-soft:#FFF0EE;
  --white:#FFFFFF;
  --ink:#241F1E;
  --ink-2:#5F5654;
  --ink-3:#948B89;
  --line:#F2E2DF;
  --bg:#FFFAF9;
  --ok:#0E9F6E;
  --shadow:0 6px 28px rgba(237,83,64,.10);
  --shadow-sm:0 2px 10px rgba(36,31,30,.05);
  --r:20px;
  --r-sm:14px;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{-webkit-text-size-adjust:100%}
body{
  font-family:'Montserrat',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
  background:var(--bg);color:var(--ink);line-height:1.6;min-height:100vh;
  overflow-x:hidden;
}
img{max-width:100%;display:block}
button{font-family:inherit}

/* ============ HEADER + PROGRESO ============ */
.site-header{
  background:var(--white);padding:14px 20px;text-align:center;
  border-bottom:1px solid var(--line);position:sticky;top:0;z-index:50;
}
.logo-img{width:120px;height:auto;margin:0 auto;object-fit:contain}
.progress-wrap{max-width:620px;margin:0 auto;padding:18px 20px 0}
.progress-bar{height:7px;background:#F3E4E1;border-radius:99px;overflow:hidden}
.progress-fill{height:100%;width:0;border-radius:99px;background:linear-gradient(90deg,var(--primary),var(--primary-light));transition:width .45s cubic-bezier(.4,0,.2,1)}
.progress-meta{display:flex;justify-content:space-between;align-items:center;margin-top:8px;gap:12px}
.progress-step{font-size:12px;font-weight:600;color:var(--ink-3);letter-spacing:.02em}
.progress-pct{font-size:12px;font-weight:700;color:var(--primary)}

/* ============ LAYOUT ============ */
.shell{max-width:620px;margin:0 auto;padding:26px 20px 48px}
.screen{display:none}
.screen.is-active{display:block;animation:fade .35s ease}
@keyframes fade{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}

/* ============ BIENVENIDA ============ */
.welcome{background:var(--white);border-radius:var(--r);padding:38px 24px;text-align:center;box-shadow:var(--shadow)}
.welcome-emoji{font-size:46px;line-height:1;margin-bottom:16px}
.pill{display:inline-block;background:var(--primary-soft);color:var(--primary);padding:7px 16px;border-radius:99px;font-size:13px;font-weight:700}
.welcome h1{font-size:clamp(25px,6.2vw,33px);font-weight:800;line-height:1.18;margin:18px 0 12px;letter-spacing:-.01em}
.welcome h1 span{color:var(--primary)}
.welcome p.lead{font-size:15.5px;color:var(--ink-2);margin-bottom:24px}
.welcome-features{display:flex;justify-content:center;gap:18px;flex-wrap:wrap;margin-bottom:26px}
.feature{display:flex;align-items:center;gap:7px;font-size:13.5px;color:var(--ink-2);font-weight:600}
.note{font-size:12.5px;color:var(--ink-3);margin-top:14px}

/* ============ BOTONES ============ */
.btn{
  width:100%;border:none;cursor:pointer;border-radius:var(--r-sm);
  padding:17px 22px;font-size:15.5px;font-weight:700;
  background:linear-gradient(135deg,var(--primary),var(--primary-dark));color:#fff;
  transition:transform .18s ease,box-shadow .18s ease,opacity .18s ease;
  box-shadow:0 4px 16px rgba(237,83,64,.22);
}
.btn:hover{transform:translateY(-2px);box-shadow:0 10px 26px rgba(237,83,64,.3)}
.btn:active{transform:translateY(0)}
.btn[disabled]{background:#E7DEDC;color:#A79E9C;box-shadow:none;cursor:not-allowed;transform:none}
.btn-ghost{
  background:none;border:none;color:var(--ink-3);font-size:13.5px;font-weight:600;
  cursor:pointer;padding:12px 4px;display:inline-flex;align-items:center;gap:6px;
}
.btn-ghost:hover{color:var(--primary)}
.nav-row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:22px;flex-wrap:wrap}
.nav-row .btn{flex:1 1 200px}

/* ============ PREGUNTAS ============ */
.q-head{margin-bottom:20px}
.q-tag{display:inline-flex;align-items:center;gap:7px;background:var(--primary-soft);color:var(--primary);padding:6px 14px;border-radius:99px;font-size:12.5px;font-weight:700;margin-bottom:14px}
.q-title{font-size:clamp(21px,5.2vw,27px);font-weight:800;line-height:1.25;letter-spacing:-.01em;margin-bottom:6px;overflow-wrap:break-word}
.q-title span{color:var(--primary)}
.q-sub{font-size:14px;color:var(--ink-2)}

.opts{display:flex;flex-direction:column;gap:11px}
.opt{
  background:var(--white);border:2px solid var(--line);border-radius:var(--r-sm);
  padding:15px 16px;cursor:pointer;display:flex;align-items:center;gap:14px;
  transition:border-color .18s,background .18s,box-shadow .18s;text-align:left;width:100%;
}
.opt:hover{border-color:var(--primary-light)}
.opt.is-selected{border-color:var(--primary);background:var(--primary-soft);box-shadow:0 0 0 3px rgba(237,83,64,.12)}
.opt:focus-visible{outline:3px solid rgba(237,83,64,.35);outline-offset:2px}
.opt-ico{
  width:46px;height:46px;flex:0 0 46px;border-radius:13px;background:var(--bg);
  display:flex;align-items:center;justify-content:center;font-size:23px;transition:background .18s;
}
.opt.is-selected .opt-ico{background:#fff}
.opt-txt{flex:1 1 auto;min-width:0;display:block}
.opt-txt .ot{display:block;font-size:15px;font-weight:700;line-height:1.35;overflow-wrap:break-word}
.opt-txt .od{display:block;font-size:12.5px;color:var(--ink-2);line-height:1.45;margin-top:2px;overflow-wrap:break-word}
.check{
  width:23px;height:23px;flex:0 0 23px;border:2px solid #DCCFCC;border-radius:7px;position:relative;transition:all .18s;
}
.opt.is-selected .check{background:var(--primary);border-color:var(--primary)}
.opt.is-selected .check::after{content:'✓';position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;font-size:13px;font-weight:800}
.check.is-radio{border-radius:50%}

.opts-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}
.opt-card{
  background:var(--white);border:2px solid var(--line);border-radius:var(--r-sm);
  padding:18px 12px;cursor:pointer;text-align:center;transition:border-color .18s,background .18s,box-shadow .18s;
}
.opt-card:hover{border-color:var(--primary-light)}
.opt-card.is-selected{border-color:var(--primary);background:var(--primary-soft);box-shadow:0 0 0 3px rgba(237,83,64,.12)}
.opt-card .ico{display:block;font-size:38px;line-height:1;margin-bottom:10px}
.opt-card .ot{display:block;font-size:13.5px;font-weight:700;line-height:1.3;overflow-wrap:break-word}
.opt-card .od{display:block;font-size:11.5px;color:var(--ink-2);margin-top:3px;line-height:1.4;overflow-wrap:break-word}

.scale{background:var(--white);border-radius:var(--r);padding:22px 12px;box-shadow:var(--shadow-sm)}
.scale-row{display:flex;gap:6px}
.scale-opt{flex:1 1 0;min-width:0;text-align:center;padding:12px 4px;border-radius:12px;border:2px solid transparent;cursor:pointer;transition:all .18s}
.scale-opt:hover{background:var(--primary-soft)}
.scale-opt.is-selected{background:var(--primary-soft);border-color:var(--primary)}
.scale-opt .emo{font-size:26px;line-height:1;margin-bottom:6px}
.scale-opt .lb{font-size:10.5px;font-weight:700;color:var(--ink-2);line-height:1.2;overflow-wrap:break-word;hyphens:auto}

.hint{
  background:linear-gradient(135deg,#FFF6E9,#FFEEDA);border-radius:var(--r-sm);
  padding:14px 16px;margin-top:18px;display:flex;gap:11px;align-items:flex-start;
}
.hint .i{font-size:20px;line-height:1.2;flex:0 0 auto}
.hint p{font-size:12.5px;color:#8A5A17;line-height:1.5}

/* ============ CARGANDO ============ */
.loading{text-align:center;padding:52px 12px}
.spinner{width:72px;height:72px;border:4px solid var(--primary-soft);border-top-color:var(--primary);border-radius:50%;animation:spin 1s linear infinite;margin:0 auto 26px}
@keyframes spin{to{transform:rotate(360deg)}}
.loading h2{font-size:21px;font-weight:800;margin-bottom:24px}
.load-steps{max-width:330px;margin:0 auto;display:flex;flex-direction:column;gap:9px}
.load-step{display:flex;align-items:center;gap:12px;padding:13px 16px;background:var(--white);border-radius:var(--r-sm);opacity:.4;transition:all .3s;font-size:13.5px;font-weight:600;text-align:left}
.load-step.is-active{opacity:1;background:var(--primary-soft)}
.load-step.is-done{opacity:1;background:#E6F7F0;color:#0B7A55}

/* ============ RESULTADOS ============ */
.res-head{text-align:center;margin-bottom:22px}
.res-head h1{font-size:clamp(23px,5.4vw,30px);font-weight:800;line-height:1.2;letter-spacing:-.01em;margin-top:14px}
.res-head h1 span{color:var(--primary)}

.card{background:var(--white);border-radius:var(--r);padding:22px;box-shadow:var(--shadow);margin-bottom:18px}
.diag-top{display:flex;align-items:center;gap:14px;margin-bottom:16px}
.diag-ico{width:54px;height:54px;flex:0 0 54px;border-radius:16px;background:var(--primary-soft);display:flex;align-items:center;justify-content:center;font-size:26px}
.diag-txt{min-width:0;flex:1 1 auto}
.diag-txt h3{font-size:17px;font-weight:800;line-height:1.3;overflow-wrap:break-word}
.diag-txt p{font-size:12.5px;color:var(--ink-2);margin-top:2px}

.meter{margin:4px 0 18px}
.meter-head{display:flex;justify-content:space-between;align-items:baseline;gap:10px;margin-bottom:7px;flex-wrap:wrap}
.meter-head b{font-size:12px;font-weight:700;color:var(--ink-3);text-transform:uppercase;letter-spacing:.06em}
.meter-head span{font-size:13px;font-weight:800;color:var(--primary)}
.meter-bars{display:flex;gap:5px}
.meter-bars i{flex:1 1 0;height:8px;border-radius:99px;background:#F1E3E0}
.meter-bars i.on{background:linear-gradient(90deg,var(--primary),var(--primary-light))}

.chips{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:16px}
.chip{background:var(--primary-soft);color:var(--primary-dark);border-radius:99px;padding:6px 12px;font-size:12px;font-weight:700;line-height:1.35;max-width:100%;overflow-wrap:break-word}

.findings{list-style:none;display:flex;flex-direction:column}
.findings li{display:flex;gap:10px;align-items:flex-start;padding:11px 0;border-top:1px solid #F6EEEC;font-size:13.5px;color:var(--ink-2);line-height:1.55;overflow-wrap:break-word}
.findings li:first-child{border-top:none}
.findings li::before{content:'✓';color:var(--primary);font-weight:800;flex:0 0 auto;line-height:1.5}
.findings b{color:var(--ink);font-weight:700}

.rec{background:linear-gradient(180deg,var(--primary-soft) 0%,var(--bg) 62%);border-radius:var(--r);padding:24px 16px;margin-top:6px}
.rec-badge{display:inline-block;background:var(--primary);color:#fff;padding:6px 14px;border-radius:99px;font-size:11.5px;font-weight:800;letter-spacing:.04em;margin-bottom:14px}
.product{background:var(--white);border-radius:var(--r);overflow:hidden;box-shadow:var(--shadow)}
.product-media{position:relative;background:linear-gradient(135deg,#FFF6F5,#FFE9E6);padding:18px;text-align:center}
.product-media img{width:100%;max-width:290px;margin:0 auto;border-radius:var(--r-sm)}
.save-badge{position:absolute;top:14px;right:14px;background:var(--primary);color:#fff;padding:7px 12px;border-radius:99px;font-size:12px;font-weight:800;box-shadow:0 4px 12px rgba(237,83,64,.3)}
.product-body{padding:22px 18px}
.product-body h2{font-size:19px;font-weight:800;line-height:1.3;overflow-wrap:break-word}
.product-body .desc{font-size:13.5px;color:var(--ink-2);margin:8px 0 18px;line-height:1.6}
.benefits{display:flex;flex-direction:column;gap:9px;margin-bottom:20px}
.benefit{display:flex;align-items:flex-start;gap:10px;font-size:13.5px;line-height:1.5}
.benefit i{width:24px;height:24px;flex:0 0 24px;border-radius:8px;background:var(--primary-soft);color:var(--primary);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:800;font-style:normal;margin-top:1px}

.plans-title{font-size:12px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-3);margin-bottom:10px}
.plans{display:flex;flex-direction:column;gap:10px;margin-bottom:18px}
.plan{
  background:var(--white);border:2px solid var(--line);border-radius:var(--r-sm);
  padding:14px;cursor:pointer;transition:border-color .18s,background .18s,box-shadow .18s;
}
.plan:hover{border-color:var(--primary-light)}
.plan.is-selected{border-color:var(--primary);background:var(--primary-soft);box-shadow:0 0 0 3px rgba(237,83,64,.10)}
.plan-top{display:flex;align-items:flex-start;gap:12px}
.plan-radio{width:21px;height:21px;flex:0 0 21px;border:2px solid #DCCFCC;border-radius:50%;position:relative;margin-top:2px;transition:all .18s}
.plan.is-selected .plan-radio{border-color:var(--primary);background:var(--primary)}
.plan.is-selected .plan-radio::after{content:'';position:absolute;inset:5px;background:#fff;border-radius:50%}
.plan-main{flex:1 1 auto;min-width:0;display:block}
.plan-name{display:block;font-size:14.5px;font-weight:800;line-height:1.35;overflow-wrap:break-word}
.plan-desc{display:block;font-size:12.5px;color:var(--ink-2);line-height:1.45;margin-top:3px;overflow-wrap:break-word}
.plan-tag{display:inline-block;background:var(--primary);color:#fff;font-size:10px;font-weight:800;letter-spacing:.04em;padding:3px 9px;border-radius:99px;margin-bottom:6px;line-height:1.5}
.plan-price{flex:0 0 auto;text-align:right;padding-left:6px}
.plan-price s{display:block;font-size:11.5px;color:var(--ink-3)}
.plan-price b{display:block;font-size:17px;font-weight:800;color:var(--primary);white-space:nowrap}

.summary{background:var(--primary-soft);border-radius:var(--r-sm);padding:16px;margin-bottom:16px;text-align:center}
.summary .lbl{font-size:12px;font-weight:700;color:var(--ink-2);margin-bottom:6px;overflow-wrap:break-word}
.summary .prices{display:flex;align-items:baseline;justify-content:center;gap:10px;flex-wrap:wrap}
.summary s{font-size:16px;color:var(--ink-3)}
.summary strong{font-size:clamp(26px,7vw,33px);font-weight:800;color:var(--primary);line-height:1.1}
.summary .save{display:inline-block;margin-top:6px;font-size:12.5px;font-weight:700;color:var(--ok)}

.btn-cta{width:100%;border:none;border-radius:var(--r-sm);cursor:pointer;padding:17px 14px;background:linear-gradient(135deg,var(--primary),var(--primary-dark));color:#fff;box-shadow:0 6px 22px rgba(237,83,64,.28);transition:transform .18s,box-shadow .18s}
.btn-cta:hover{transform:scale(1.015);box-shadow:0 10px 30px rgba(237,83,64,.36)}
.btn-cta .t{display:block;font-size:16px;font-weight:800;letter-spacing:.01em}
.btn-cta .s{display:block;font-size:11.5px;font-weight:600;opacity:.92;margin-top:3px}
.btn-cta[disabled]{opacity:.7;cursor:wait;transform:none}
.trust{display:flex;justify-content:center;gap:14px;flex-wrap:wrap;margin-top:16px;font-size:11.5px;color:var(--ink-2);font-weight:600}

.tst{margin-top:22px}
.tst-title{font-size:14px;font-weight:800;text-align:center;margin-bottom:12px}
.tst-card{background:var(--white);border-radius:var(--r-sm);padding:18px;box-shadow:var(--shadow-sm)}
.tst-top{display:flex;align-items:center;gap:11px;margin-bottom:9px}
.tst-av{width:42px;height:42px;flex:0 0 42px;border-radius:50%;background:var(--primary-soft);display:flex;align-items:center;justify-content:center;font-size:19px}
.tst-top h4{font-size:13.5px;font-weight:700}
.tst-top p{font-size:11.5px;color:var(--ink-3)}
.stars{color:#F5A524;letter-spacing:2px;font-size:13px;margin-bottom:8px}
.tst-text{font-size:13.5px;color:var(--ink-2);line-height:1.6;font-style:italic;overflow-wrap:break-word}
.restart{text-align:center;margin-top:20px}
.legal{text-align:center;font-size:11px;color:var(--ink-3);margin-top:18px;line-height:1.5}

@media (max-width:420px){
  .logo-img{width:104px}
  .shell{padding:22px 15px 40px}
  .progress-wrap{padding:16px 15px 0}
  .card,.welcome{padding:20px 16px}
  .rec{padding:20px 12px}
  .product-body{padding:20px 15px}
  .opts-grid{grid-template-columns:1fr}
  .opt-ico{width:42px;height:42px;flex:0 0 42px;font-size:21px}
  .scale-row{gap:4px}
  .scale-opt{padding:10px 2px}
  .scale-opt .emo{font-size:22px}
  .scale-opt .lb{font-size:9.5px}
  .plan-top{flex-wrap:wrap}
  .plan-price{width:100%;text-align:left;padding-left:33px;margin-top:6px;display:flex;align-items:baseline;gap:8px}
  .plan-price s{font-size:12px}
}
@media (prefers-reduced-motion:reduce){
  *{animation-duration:.001ms !important;transition-duration:.001ms !important}
}
</style>
</head>
<body>

<header class="site-header">
  <img class="logo-img" src="https://cdn.shopify.com/s/files/1/0611/6999/1768/files/Captura_de_pantalla_2024-08-17_a_la_s_10.12.03_a._m..png?v=1725138729" alt="Fem" width="120" height="40">
</header>

<div class="progress-wrap">
  <div class="progress-bar"><div class="progress-fill" id="pFill"></div></div>
  <div class="progress-meta">
    <span class="progress-step" id="pStep">Empecemos</span>
    <span class="progress-pct"><span id="pPct">0</span>%</span>
  </div>
</div>

<main class="shell">

  <!-- BIENVENIDA -->
  <section class="screen is-active" id="scWelcome">
    <div class="welcome">
      <div class="welcome-emoji">🌸</div>
      <span class="pill">✨ Diagnóstico gratuito</span>
      <h1>Descubre qué necesita tu <span>cuerpo</span></h1>
      <p class="lead">Responde unas preguntas rápidas y te mostramos la solución Fem que mejor se adapta a ti.</p>
      <div class="welcome-features">
        <div class="feature"><span>⏱️</span><span>2 minutos</span></div>
        <div class="feature"><span>🔬</span><span>Personalizado</span></div>
        <div class="feature"><span>💝</span><span>Confidencial</span></div>
      </div>
      <button class="btn" type="button" id="btnStart">Comenzar mi diagnóstico →</button>
      <p class="note">🔒 Tus respuestas son privadas y no se comparten</p>
    </div>
  </section>

  <!-- PREGUNTAS (dinámico) -->
  <section class="screen" id="scQuestion" aria-live="polite"></section>

  <!-- CARGANDO -->
  <section class="screen" id="scLoading">
    <div class="loading">
      <div class="spinner"></div>
      <h2>Analizando tus respuestas…</h2>
      <div class="load-steps">
        <div class="load-step" id="ls0"><span>📊</span><span>Evaluando tus síntomas</span></div>
        <div class="load-step" id="ls1"><span>🔬</span><span>Comparando con tu perfil</span></div>
        <div class="load-step" id="ls2"><span>💝</span><span>Preparando tu recomendación</span></div>
      </div>
    </div>
  </section>

  <!-- RESULTADOS (dinámico) -->
  <section class="screen" id="scResults"></section>

</main>

<script>
(function(){
  'use strict';

  /* =========================================================
     1) IMÁGENES
     Las imágenes de la soda van embebidas para que funcionen
     de inmediato. Si las subes a Shopify (Contenido > Archivos),
     reemplaza el valor por la URL del CDN. Nada más cambia.
     ========================================================= */
  var IMG = {
    sodaSixPack : 'data:image/jpeg;base64,',
    sodaCombo   : 'data:image/jpeg;base64,',
    vaginal     : 'https://cdn.shopify.com/s/files/1/0611/6999/1768/files/FotoDSC00239.webp?v=1762371725',
    pms         : 'https://cdn.shopify.com/s/files/1/0611/6999/1768/files/Adobe_Express_-_file_8ad5ca71-ed08-457d-bb20-8f0cb1b50165.webp?v=1760477514',
    mom         : 'https://cdn.shopify.com/s/files/1/0611/6999/1768/files/IMG_0876-2.webp?v=1765571294'
  };

  /* =========================================================
     2) CONFIGURACIÓN DEL QUIZ
     Todo el contenido vive aquí. Añadir o quitar preguntas
     no rompe nada: el motor las renderiza automáticamente.
     Tipos de pregunta: 'multi' | 'single' | 'grid' | 'scale'
     ========================================================= */

  var CATEGORIES = [
    { id:'vaginal',   icon:'🌺', title:'Salud vaginal',           desc:'Flujo, olor, picazón o infecciones' },
