{% doc %}
  Renders a decorative homepage icon.
  @param {string} icon - Icon name.
  @example
  {% render 'fem-home-hero-icon', icon: 'check' %}
{% enddoc %}
<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {% case icon %}
    {% when 'arrow' %}<path d="M4 12h16m-6-6 6 6-6 6"/>
    {% when 'check' %}<path d="m4 12 5 5L20 6"/>
    {% when 'capsule' %}<path d="m9 3-6 6a6 6 0 0 0 8.5 8.5l6-6A6 6 0 0 0 9 3Z" transform="translate(2 2)"/><path d="m8 9 7 7m-3-9 2-2"/>
    {% when 'award' %}<circle cx="12" cy="9" r="7"/><circle cx="12" cy="9" r="3.5"/><path d="m7 14-1 8 6-4 6 4-1-8"/>
    {% when 'shield' %}<path d="M4 4h16v7c0 6-8 10-8 10S4 17 4 11V4Z"/><path d="m8 11 3 3 5-6"/>
    {% when 'seal' %}<path d="m12 2 3 3 4 .5.5 4 3 2.5-3 3-.5 4-4 .5-3 3-3-3-4-.5-.5-4-3-3 3-2.5.5-4 4-.5 3-3Z"/><path d="m8 12 3 3 5-6"/>
  {% endcase %}
</svg>
