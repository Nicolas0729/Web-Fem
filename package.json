{
  "name": "fem-storefront",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build-theme.ts",
    "dev": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "audit:public": "python3 scripts/audit-store.py",
    "audit:links": "tsx scripts/check-links.ts",
    "theme:dev": "shopify theme dev --store fd668e-73.myshopify.com --path theme-dev",
    "theme:check": "shopify theme check --path theme-dev"
  },
  "devDependencies": {
    "@shopify/theme-check-common": "^3.29.0",
    "@shopify/theme-check-docs-updater": "^3.29.0",
    "@shopify/theme-check-node": "^3.29.0",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "liquidjs": "^10.29.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  }
}
